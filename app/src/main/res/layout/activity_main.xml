<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:orientation="vertical"
 android:padding="24dp"
 android:gravity="center_horizontal"
 android:layout_width="match_parent"
 android:layout_height="match_parent">

 <TextView
  android:text="ShieldDNS"
  android:textSize="30sp"
  android:textStyle="bold"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content"/>

 <TextView
  android:id="@+id/status"
  android:text="Protection is OFF"
  android:textSize="18sp"
  android:paddingTop="24dp"
  android:paddingBottom="12dp"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content"/>

 <TextView
  android:id="@+id/adminStatus"
  android:text="Removal protection: OFF"
  android:textSize="16sp"
  android:paddingBottom="20dp"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content"/>

 <Button
  android:id="@+id/start"
  android:text="START FAMILY FILTER"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"/>

 <Button
  android:id="@+id/enableAdmin"
  android:text="ENABLE REMOVAL PROTECTION"
  android:layout_marginTop="12dp"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"/>

 <Button
  android:id="@+id/stop"
  android:text="STOP FILTER"
  android:layout_marginTop="12dp"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"/>

 <TextView
  android:text="TEST BUILD 0.2\nDNS-only local VPN with CleanBrowsing Family Filter and fallback resolver. Removal protection uses Android Device Admin; full uninstall blocking is applied automatically only when Android reports ShieldDNS as Device Owner."
  android:paddingTop="24dp"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"/>
</LinearLayout>
